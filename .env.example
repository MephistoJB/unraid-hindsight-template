HINDSIGHT_APPDATA=/mnt/user/appdata/hindsight
HINDSIGHT_DB_NAME=hindsight
HINDSIGHT_DB_USER=hindsight
HINDSIGHT_DB_PASSWORD=replace-with-a-long-random-password
# Used by compose/external-postgres.yaml. Percent-encode reserved password characters.
HINDSIGHT_DATABASE_URL=postgresql://hindsight:replace-with-a-long-random-password@host.docker.internal:5432/hindsight
HINDSIGHT_API_KEY=replace-with-a-long-random-api-key
HINDSIGHT_CP_ACCESS_KEY=replace-with-a-different-long-random-ui-key
HINDSIGHT_LLM_BASE_URL=http://macserver:11434/v1
HINDSIGHT_LLM_MODEL=qwen3-coder:30b
HINDSIGHT_LLM_MAX_CONCURRENT=1
HINDSIGHT_LLM_TIMEOUT=300
HINDSIGHT_LLM_MAX_RETRIES=2
HINDSIGHT_LLM_CONTEXT=16384
HINDSIGHT_WORKER_MAX_SLOTS=2
HINDSIGHT_CONSOLIDATION_MAX_SLOTS=1
HINDSIGHT_OPERATION_RETENTION_DAYS=30
HINDSIGHT_OBSERVATIONS_ENABLED=false
HINDSIGHT_AUTO_CONSOLIDATION_ENABLED=false
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999
